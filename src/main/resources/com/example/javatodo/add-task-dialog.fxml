<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="10.0" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.example.javatodo.controller.AddTaskController"
      stylesheets="@app.css">
    <padding>
        <Insets bottom="10.0" left="10.0" right="10.0" top="10.0"/>
    </padding>

    <Label text="Название *"/>
    <TextField fx:id="titleField"/>

    <Label text="Описание *"/>
    <TextArea fx:id="descriptionField" prefRowCount="3"/>

    <Label text="Срок *"/>
    <DatePicker fx:id="dueDateField"/>

    <HBox alignment="CENTER_RIGHT" spacing="10.0">
        <Button onAction="#onCancelClick" text="Отмена"/>
        <Button defaultButton="true" onAction="#onSaveClick" text="Сохранить"/>
    </HBox>
</VBox>
